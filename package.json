{
  "name": "alyx-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run verify",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint apps scripts vite.shared.ts --ignore-pattern apps/podcast-episodes/public/episode-bundle.js",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b apps/catalog/tsconfig.json apps/imposter-game/tsconfig.json apps/rounding-game/tsconfig.json --pretty false",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.2.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
